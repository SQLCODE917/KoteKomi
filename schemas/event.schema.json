{
  "$defs": {
    "EventMention": {
      "additionalProperties": false,
      "description": "One embedded link from an Event to its exact source evidence.",
      "properties": {
        "expression_evidence_target_id": {
          "pattern": "^etg_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Expression Evidence Target Id",
          "type": "string"
        },
        "head_evidence_target_id": {
          "pattern": "^etg_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Head Evidence Target Id",
          "type": "string"
        },
        "id": {
          "pattern": "^evm_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "support_evidence_target_id": {
          "pattern": "^etg_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Support Evidence Target Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "head_evidence_target_id",
        "expression_evidence_target_id",
        "support_evidence_target_id"
      ],
      "title": "EventMention",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "end_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End At"
    },
    "id": {
      "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "mentions": {
      "items": {
        "$ref": "#/$defs/EventMention"
      },
      "title": "Mentions",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "participant_actor_ids": {
      "items": {
        "pattern": "^act_[A-Za-z0-9][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "title": "Participant Actor Ids",
      "type": "array"
    },
    "participant_organization_ids": {
      "items": {
        "pattern": "^org_[A-Za-z0-9][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "title": "Participant Organization Ids",
      "type": "array"
    },
    "place_id": {
      "anyOf": [
        {
          "pattern": "^plc_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Place Id"
    },
    "start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start At"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Event",
  "type": "object"
}
