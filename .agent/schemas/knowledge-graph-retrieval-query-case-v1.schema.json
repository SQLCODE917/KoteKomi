{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/knowledge-graph-retrieval-query-case-v1.schema.json",
  "title": "KoteKomi Knowledge-Graph retrieval query case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "seed_text",
    "maximum_hops",
    "required_selected_record_ids",
    "require_context",
    "gate"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-graph-retrieval-query-case-v1"},
    "query_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "seed_text": {"type": "string", "minLength": 1},
    "maximum_hops": {"enum": [1, 2]},
    "required_selected_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "require_context": {"const": true},
    "gate": {"const": "required"}
  }
}
