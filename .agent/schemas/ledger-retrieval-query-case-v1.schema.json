{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/ledger-retrieval-query-case-v1.schema.json",
  "title": "KoteKomi Ledger retrieval query case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "policy",
    "required_selected_record_ids",
    "require_context",
    "gate"
  ],
  "properties": {
    "schema_version": {"const": "ledger-retrieval-query-case-v1"},
    "query_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "query_text": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["assertion", "relationship", "outcome"]},
    "assertion_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "subject_id": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "policy": {"enum": ["current-relevance", "current-latest", "audit-history"]},
    "required_selected_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "predecessor_id": {"type": ["string", "null"]},
        "successor_id": {"type": ["string", "null"]}
      }
    },
    "require_context": {"type": "boolean"},
    "gate": {"enum": ["required", "diagnostic"]}
  }
}
