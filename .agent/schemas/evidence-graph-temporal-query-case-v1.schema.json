{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/evidence-graph-temporal-query-case-v1.schema.json",
  "title": "KoteKomi evidence graph temporal query case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "view_kind",
    "as_of",
    "relationship_id",
    "required_evidence_target_ids",
    "required_terminal_assertion_ids",
    "required_anchor_text",
    "require_context",
    "gate"
  ],
  "properties": {
    "schema_version": {"const": "evidence-graph-temporal-query-case-v1"},
    "query_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "view_kind": {"enum": ["current", "as_of"]},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "relationship_id": {"type": "string", "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "required_evidence_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^etg_[A-Za-z0-9][A-Za-z0-9_-]*$"}
    },
    "required_terminal_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ast_[A-Za-z0-9][A-Za-z0-9_-]*$"}
    },
    "required_anchor_text": {"type": "string", "minLength": 1},
    "require_context": {"const": true},
    "gate": {"const": "required"}
  },
  "allOf": [
    {
      "if": {"properties": {"view_kind": {"const": "current"}}},
      "then": {"properties": {"as_of": {"const": null}}}
    },
    {
      "if": {"properties": {"view_kind": {"const": "as_of"}}},
      "then": {"properties": {"as_of": {"type": "string", "format": "date-time"}}}
    }
  ]
}
