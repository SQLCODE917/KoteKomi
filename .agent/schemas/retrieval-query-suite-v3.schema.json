{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/retrieval-query-suite-v3.schema.json",
  "title": "KoteKomi retrieval query suite v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "scenario_id", "description", "cumulative", "execution_order", "query_pack_paths", "required_planes", "required_channels", "policy_ids", "thresholds"],
  "properties": {
    "schema_version": {"const": "retrieval-query-suite-v3"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "cumulative": {"const": true},
    "execution_order": {"type": "array", "prefixItems": [{"const": "test-ingest"}, {"const": "test-query"}], "items": false, "minItems": 2, "maxItems": 2},
    "query_pack_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.agent/scenarios/.+\\.jsonl$"}},
    "required_planes": {"const": ["document"]},
    "required_channels": {"const": ["exact", "lexical", "semantic"]},
    "policy_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_policy_id", "projection_policy_id", "query_policy_id", "context_profile_id", "embedding_profile_id"],
      "properties": {
        "unit_policy_id": {"const": "document_node_unit_v1"},
        "projection_policy_id": {"const": "document_semantic_projection_v1"},
        "query_policy_id": {"const": "document_exact_lexical_semantic_rrf60_v1"},
        "context_profile_id": {"type": "string", "minLength": 1},
        "embedding_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {"type": "object", "additionalProperties": true}
  }
}
