{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/evidence-graph-temporal-suite-v1.schema.json",
  "title": "KoteKomi evidence graph temporal suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "scenario_id",
    "seed_path",
    "query_pack_paths",
    "projection_policy_id",
    "require_rebuild_equivalence"
  ],
  "properties": {
    "schema_version": {"const": "evidence-graph-temporal-suite-v1"},
    "suite_id": {"const": "dr-6-1c-v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed_path": {"type": "string", "pattern": "^\\.agent/scenarios/.+\\.json$"},
    "query_pack_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\.agent/scenarios/.+\\.jsonl$"}
    },
    "projection_policy_id": {"const": "evidence_graph_temporal_relationship_contributions_v1"},
    "require_rebuild_equivalence": {"const": true}
  }
}
