{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/ledger-retrieval-suite-v1.schema.json",
  "title": "KoteKomi Ledger retrieval suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "scenario_id",
    "seed_path",
    "query_pack_paths",
    "required_channels",
    "require_rebuild_equivalence"
  ],
  "properties": {
    "schema_version": {"const": "ledger-retrieval-suite-v1"},
    "suite_id": {"type": "string", "pattern": "^dr-[0-9]+-v[0-9]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed_path": {"type": "string", "pattern": "^\\.agent/scenarios/.+\\.json$"},
    "query_pack_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\.agent/scenarios/.+\\.jsonl$"}
    },
    "required_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["exact", "lexical", "structured_filter"]}
    },
    "require_rebuild_equivalence": {"const": true}
  }
}
