{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/evidence-graph-query-case-v1.schema.json",
  "title": "KoteKomi evidence graph query case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "graph_seed",
    "relationship_id",
    "required_evidence_target_ids",
    "required_terminal_assertion_ids",
    "require_context",
    "gate"
  ],
  "properties": {
    "schema_version": {"const": "evidence-graph-query-case-v1"},
    "query_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "graph_seed": {"type": "string", "minLength": 1},
    "relationship_id": {"type": "string", "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "required_evidence_target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^etg_[A-Za-z0-9][A-Za-z0-9_-]*$"}
    },
    "required_terminal_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ast_[A-Za-z0-9][A-Za-z0-9_-]*$"}
    },
    "require_context": {"const": true},
    "gate": {"const": "required"}
  }
}
