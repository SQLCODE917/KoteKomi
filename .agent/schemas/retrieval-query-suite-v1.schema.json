{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotekomi.local/schemas/retrieval-query-suite-v1.schema.json",
  "title": "KoteKomi retrieval query suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "scenario_id",
    "description",
    "cumulative",
    "execution_order",
    "query_pack_paths",
    "required_planes",
    "required_channels",
    "policy_ids",
    "thresholds"
  ],
  "properties": {
    "schema_version": {
      "const": "retrieval-query-suite-v1"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cumulative": {
      "const": true
    },
    "execution_order": {
      "type": "array",
      "prefixItems": [
        {
          "const": "test-ingest"
        },
        {
          "const": "test-query"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "query_pack_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.agent/scenarios/.+\\.jsonl$"
      }
    },
    "required_planes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "document",
          "ledger",
          "knowledge_graph"
        ]
      }
    },
    "required_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact",
          "lexical",
          "semantic",
          "structured_filter",
          "graph_traversal",
          "hierarchy"
        ]
      }
    },
    "policy_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_policy_id",
        "projection_policy_id",
        "query_policy_id",
        "context_profile_id"
      ],
      "properties": {
        "unit_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "projection_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "query_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "context_profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_case_pass_rate",
        "unique_exact_rank_1_rate",
        "require_zero_forbidden_evidence",
        "require_rebuild_equivalence"
      ],
      "properties": {
        "required_case_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unique_exact_rank_1_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_zero_forbidden_evidence": {
          "const": true
        },
        "require_rebuild_equivalence": {
          "const": true
        }
      }
    }
  }
}
